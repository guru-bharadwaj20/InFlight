# Copy to .env before running `docker compose up`.
# Values below are the local-development defaults.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=concurrent_chat
POSTGRES_PORT=5432

# Used by the Prisma CLI, which runs on the HOST and reaches Postgres
# through the port docker-compose publishes on localhost.
# The backend container gets its own DATABASE_URL from docker-compose.yml
# (host `postgres` instead of `localhost`).
DATABASE_URL=postgresql://chat:chat@localhost:5432/concurrent_chat?schema=public

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Services -------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Gemini ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main generation model.
GENERATION_MODEL=gemini-2.5-flash
# Cheap/fast model for the Stage 7 dependency classifier.
CLASSIFIER_MODEL=gemini-2.5-flash-lite

# --- Concurrency guardrails (Stage 10) ------------------------------------
MAX_CONCURRENT_JOBS_PER_CONVERSATION=8

# Streams a deterministic local response instead of calling Gemini. For
# demoing/loadtesting concurrency without spending tokens. Never enable this
# and then judge answer quality — the answers are filler text.
USE_FAKE_LLM=false
# Delay between chunks from the fake generator. Lower it to make the load test
# finish faster; raise it to watch concurrency unfold at human speed.
FAKE_LLM_CHUNK_DELAY_MS=45

# --- Frontend (must be NEXT_PUBLIC_ to reach the browser) -----------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Auth ---------------------------------------------------------------
# Signs session tokens. REQUIRED -- docker compose refuses to start without it,
# and the backend refuses to boot if it is left at the built-in dev value.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Escape hatch for running with the built-in dev secret. Leave false: with it
# true, every session token is forgeable by anyone who has read this repo.
ALLOW_DEFAULT_JWT_SECRET=false
# How long a session token lasts. Logging out revokes the token server-side, so
# this is the ceiling on a token nobody revokes, not on every token.
JWT_EXPIRE_HOURS=168

# --- Dependency resolution -------------------------------------------------
# A dependent job waits for everything submitted before it; past this cap it
# proceeds with a slightly stale snapshot rather than never answering.
MAX_DEPENDENCY_WAIT_SECONDS=120
DEPENDENCY_POLL_INTERVAL_MS=150
# Optimistic concurrency: when true, an auto-detected *dependent* prompt does
# not block. It generates against the current snapshot and only re-runs if the
# retrospective check confirms it missed context. Costs a second model call
# whenever the bet loses, which is why it is off by default.
SPECULATIVE_EXECUTION=false

# --- Context window --------------------------------------------------------
# How much settled history a job carries into its prompt. Unbounded, per-message
# cost grows with conversation length and a long chat eventually exceeds the
# model's context window. 0 disables either bound.
MAX_CONTEXT_EXCHANGES=40
MAX_CONTEXT_CHARS=400000

# --- Admission control -----------------------------------------------------
# Process-wide bound on concurrent generations; 0 disables the gate.
MAX_GLOBAL_CONCURRENCY=64
# Requests/minute to the model, smoothed by a token bucket. 0 means unlimited;
# set it to your provider's real limit to turn overload into backpressure
# (waiting) rather than a burst of 429s.
GENERATION_RATE_PER_MIN=0

# --- Provider resilience ---------------------------------------------------
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BASE_SECONDS=1.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# --- Rate limiting ---------------------------------------------------------
# Login is limited per address AND per targeted account; either alone is easy to
# walk around. 0 disables an individual limit.
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT_PER_IP=5
SIGNUP_RATE_WINDOW_SECONDS=3600
# Only enable behind a proxy that actually sets X-Forwarded-For. The header is
# attacker-controlled, so trusting it without one lets anyone mint a fresh
# rate-limit budget per request.
TRUST_PROXY_HEADERS=false

# --- Limits ----------------------------------------------------------------
# Hard ceiling on a request body, checked before the body is read.
MAX_REQUEST_BYTES=16777216

# --- Observability ---------------------------------------------------------
# Guards /metrics and /traces. Leave empty and they require a signed-in user;
# set it and give the value to your Prometheus scraper, which has no account.
METRICS_TOKEN=
LOG_LEVEL=INFO
# JSON lines carrying request/job ids. Set false for readable output locally.
LOG_JSON=true

# --- Shutdown --------------------------------------------------------------
# On SIGTERM, how long to let in-flight generations finish before cancelling
# them. docker-compose's stop_grace_period must exceed this.
DRAIN_TIMEOUT_SECONDS=20

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
